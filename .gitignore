# Xcode — the project is generated from project.yml by XcodeGen.
# Committing it produces merge conflicts and stale settings (it once kept
# the pre-rebrand display name alive); run `xcodegen generate` instead.
*.xcodeproj/
build/
dist/
DerivedData/
xcuserdata/
*.xcuserstate
*.xcscmblueprint

# macOS
.DS_Store

# Local signing identity — never commit account information.
Config/local.xcconfig

# Pre-release working document (local checklist, not part of the project).
release-review.md

# Local App Store dress-rehearsal build products.
build-mas/
