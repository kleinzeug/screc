<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Signs for the Mac App Store and writes the .pkg to disk.
	     destination is deliberately "export", NOT "upload": exporting must
	     never publish as a side effect. Uploading is an explicit, separate
	     step — see docs/RELEASING.md. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>export</string>
	<key>signingStyle</key>
	<string>automatic</string>
</dict>
</plist>
