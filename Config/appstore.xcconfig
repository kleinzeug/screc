// Mac App Store configuration. Committed, and deliberately free of any
// account information: the team id comes from the optional (gitignored)
// local.xcconfig, exactly like the ad-hoc/dev setup in signing.xcconfig.
//
// CODE_SIGN_IDENTITY is deliberately NOT set here. With automatic signing,
// forcing "Apple Distribution" makes xcodebuild refuse the archive
// ("conflicting provisioning settings"): the archive is signed for
// development and the *export* step re-signs it for distribution, driven by
// Config/ExportOptionsAppStore.plist. See docs/RELEASING.md.
CODE_SIGN_ENTITLEMENTS = Config/screc-mas.entitlements
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =

#include? "local.xcconfig"
