<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Local & Developer ID builds: no sandbox. Screen recording needs no
	     entitlement at all — it is purely a TCC (privacy) permission. -->
	<!-- The microphone is different: these builds enable the hardened
	     runtime, which refuses audio input WITHOUT this entitlement — before
	     TCC is consulted, so no permission prompt ever appears and the app
	     never shows up in System Settings → Privacy → Microphone. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
